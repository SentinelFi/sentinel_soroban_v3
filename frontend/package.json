{
  "name": "sentinel-frontend",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "start": "concurrently --kill-others-on-fail --names stellar,vite -c gray,green --pad-prefix \"stellar scaffold watch --build-clients --manifest-path ../contracts/Cargo.toml\" \"vite\"",
    "build": "tsc -b && vite build",
    "install:contracts": "npm install --workspace=packages && npm run build --workspace=packages",
    "rebuild-bindings": "bash rebuild-bindings.sh",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "typecheck": "tsc"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@ark-ui/react": "^5.34.1",
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "@stellar/design-system": "^3.2.7",
    "@stellar/stellar-sdk": "^14.4.3",
    "@stellar/stellar-xdr-json": "^23.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.17",
    "@theahaco/contract-explorer": "^1.1.0",
    "@theahaco/ts-config": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lossless-json": "^4.3.0",
    "lucide-react": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.23",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "prettier": "@theahaco/ts-config/prettier"
}
