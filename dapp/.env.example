# ──────────────────────────────────────────────────────────────────────
# Frontend (Vite) — PUBLIC_ prefix, bundled into the browser build.
# Safe to expose; never put secrets here.
# ──────────────────────────────────────────────────────────────────────
PUBLIC_STELLAR_NETWORK="TESTNET"
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
PUBLIC_STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# Admin console (/admin) identity — Supabase Auth only; the anon key can
# read nothing (RLS deny-all). Server-side twin vars live below.
PUBLIC_SUPABASE_URL="https://murcgnleczppbooifkya.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="sb_publishable_Kiz258A9ZoKQbicRSAndfQ_2nNFu1cA"

# ──────────────────────────────────────────────────────────────────────
# Server-side — Vercel env vars, no PUBLIC_ prefix, never shipped to
# the browser. Consumed only by the serverless cron functions in api/.
# Set these in the Vercel project settings (or a local .env for
# `npm run dev:api`). Vite's envPrefix is PUBLIC_, so even a local .env
# containing these will not leak into the frontend bundle.
# ──────────────────────────────────────────────────────────────────────

# Network (defaults to testnet if unset)
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract IDs (default to deployments/testnet.json addresses if unset)
ORACLE_AGGREGATOR_ID="CDMKBMNJ2YZTARAM4ZUU7HZJZA7UUYJU76ZOAN2SCR3WJYZSSHXV7ESW"
CONTROLLER_ID="CBDJIPZOC7KH3ICK57MAUZMUXBQ5XF56WJLRP2OY6FF5V2HOFDOFXVY3"
RISK_VAULT_ID="CCJLBWEOPNUHIUNOGZMUDQ6EGO563SA3WSEX2NENEDCTJDZOKN3LLDKF"
GOVERNANCE_ID="CATUCJILWACDDEAIFXRL6HXSYDZ7TLOXHMUBKBG4URDOUJHEO7QAJ6NE"
FLIGHT_POOL_MANAGER_ID="CAA7DVZKQEA7JENAMI7DEKPGAWJQMPY6MKDED2DG2ZCK2G535X5V2PI7"

# Signing keys — REQUIRED, no defaults. Secrets: Vercel env only.
# oracle: authorized on OracleAggregator (set_estimated_arrival/set_landed/set_cancelled)
# keeper: authorized on Controller (classify_flights/execute_settlements/run_queue_maintenance)
# ttl:    any funded account (extend_ttl and prune_settled are permissionless)
ORACLE_SECRET_KEY=""
KEEPER_SECRET_KEY=""
TTL_EXTENDER_SECRET_KEY=""

# AeroAPI (FlightAware). Base defaults to the real API; point it at the
# mock (tools/mock-aeroapi, http://localhost:3001) for local testing.
AEROAPI_BASE_URL="https://aeroapi.flightaware.com/aeroapi"
AEROAPI_KEY=""

# Shared secret for invoking the cron endpoints — REQUIRED for any
# deployment that runs the scheduled crons (vercel.backend.json). The
# handler fails closed: when this is unset every /api/cron/* request is
# rejected with 401. Vercel's cron scheduler automatically sends
# `Authorization: Bearer $CRON_SECRET` once it is set as a project env
# var, so set it in Vercel BEFORE enabling the crons; manual/external
# callers must send the same header. Generate with `openssl rand -hex 32`.
# (The local bots runner, scripts/run_bot.ts, calls each job directly and
# does not need this.)
CRON_SECRET=""

# Governance agent (route_agent cron + whitelist script). Must be a
# GovernanceModule ADMIN (owner runs add_admin once) — never the owner key.
GOVERNANCE_ADMIN_SECRET_KEY=""

# Sale authorizer (cron #0). Flight list + default horizon come from
# config/routes.testnet.json; these env vars override the horizon and the
# per-window validity (on-chain cap: 86400s).
SALE_AUTH_HORIZON_DAYS=""
SALE_AUTH_VALIDITY_SECS=""

# ML prediction service (agent/ on Render, service
# "flight-delay-predictions" — pure /predict API; premium math lives in
# route_rules.ts). Unset = route agent prices from the routes file only.
# AGENT_TOKEN must match the service's env if set.
AGENT_BASE_URL=""
AGENT_TOKEN=""

# Render REST API key (dashboard → Account Settings → API Keys) — used
# only by local tooling to create/manage the Render service. Never
# deployed anywhere.
RENDER_API_KEY=""

# Weather (Open-Meteo — keyless; override for testing only).
WEATHER_BASE_URL=""

# Governance DB (Supabase project "sentinel", ref murcgnleczppbooifkya).
# MUST be the Supavisor TRANSACTION pooler (port 6543) — serverless
# functions would exhaust direct Postgres connections, and the direct
# host is IPv6-only. RLS is deny-all with zero policies; this
# server-side connection is the only data path.
#   postgresql://postgres.murcgnleczppbooifkya:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
GOVERNANCE_DB_URL=""

# Admin UI auth (api/admin/*). Supabase Auth is identity-only — data
# stays on the pooler connection above. ADMIN_EMAILS is the allowlist;
# actions_log records which admin acted. The frontend needs the same
# two Supabase values as PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_URL="https://murcgnleczppbooifkya.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_Kiz258A9ZoKQbicRSAndfQ_2nNFu1cA"
ADMIN_EMAILS=""

# Reconciler safety: "true" = compute + log decisions, submit nothing.
# Keep true until the gov key is a GovernanceModule admin (add_admin).
GOV_DRY_RUN="true"

# Contract owner PUBLIC address (owner-only calls: set_defaults, term limits,
# add_admin, pauses). The secret stays in the local stellar identity, never env.
CONTRACT_OWNER_ADDRESS=GCEODBNVUGJVYQKWY7NMU4U3EIYQOXA7LADMQOPNB5PBBKMYCQJ7E6KD
