{
  "name": "sentinel-arcade",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "install:contracts": "npm install --workspaces && npm run build --workspaces --if-present",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "whitelist:routes": "tsx scripts/whitelist_routes.ts"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "@stellar/stellar-sdk": "^14.4.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.17",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.12.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vercel/node": "^5.8.26",
    "@vitejs/plugin-react": "^5.1.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
