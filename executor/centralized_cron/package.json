{
  "name": "sentinel-centralized-cron",
  "version": "0.1.0",
  "description": "Centralized cron executor for Sentinel Protocol — 5 cron jobs (oracle, classifier, settler, queue maintainer, ttl extender)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "fetch": "tsx src/run_once.ts fetch",
    "classify": "tsx src/run_once.ts classify",
    "settle": "tsx src/run_once.ts settle",
    "queue": "tsx src/run_once.ts queue",
    "ttl": "tsx src/run_once.ts ttl",
    "test": "bash test.sh",
    "test:pipeline": "bash test_pipeline.sh",
    "test:run-log": "tsx src/test_run_log.ts",
    "test:aeroapi": "tsx src/test_aeroapi.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.6.1",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
