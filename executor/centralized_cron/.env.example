# Sentinel Protocol — Centralized Cron Executor (Phase 3 contracts)
# Copy to .env and fill in values from your deploy script output.

# ── Stellar network ───────────────────────────────────────────────
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contract IDs ──────────────────────────────────────────────────
# All five production contracts from the Phase 3 reorg.
ORACLE_AGGREGATOR_ID=
CONTROLLER_ID=
RISK_VAULT_ID=
GOVERNANCE_ID=
FLIGHT_POOL_MANAGER_ID=

# ── Executor keypairs (secret keys) ───────────────────────────────
# Oracle key — set as the OracleAggregator's authorized_oracle. Writes
# set_estimated_arrival, set_landed, set_cancelled.
ORACLE_SECRET_KEY=

# Keeper key — set as the Controller's authorized_keeper. Drives
# classify_flights, execute_settlements, and run_queue_maintenance
# (audit M-03 split — same authorized address, different cron jobs).
KEEPER_SECRET_KEY=

# TTL Extender key — any funded account; extend_ttl() and prune_settled()
# are permissionless. Keeping a dedicated key isolates daily TTL fees
# from oracle/keeper accounts.
TTL_EXTENDER_SECRET_KEY=

# ── AeroAPI ──────────────────────────────────────────────────────
# For mock: http://localhost:3001
# For real: https://aeroapi.flightaware.com/aeroapi
AEROAPI_BASE_URL=http://localhost:3001
AEROAPI_KEY=

# ── E2E test (optional) ──────────────────────────────────────────
# Used only by test_pipeline.sh to buy insurance + drive the cron loop.
TRAVELER_SECRET_KEY=
UNDERWRITER_SECRET_KEY=
MOCK_USDC_ID=

# ── HTTP server ──────────────────────────────────────────────────
PORT=3002
